# Copy this file to apps/web/.env for local development.
# `docker compose -f docker/docker-compose.yml up -d` starts Postgres + Redis
# with credentials that match the default DATABASE_URL/REDIS_URL below.

DATABASE_URL="postgresql://gold:goldpass@localhost:5433/gold_bd?schema=public"
REDIS_URL="redis://localhost:6379"

# Any long random string in development; use a real secret manager in production.
JWT_SECRET="dev-only-change-me-32-chars-minimum-please"

NODE_ENV="development"
