// Gold BD — domain schema.
// Money is stored as Decimal (BDT, 2dp). Gold is stored as an integer count of
// milligrams (goldBalanceMg / goldMg) so balances never drift from float rounding;
// convert to/from grams only at the presentation layer (see @gold-bd/utils).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

enum LedgerAccount {
  CASH
  GOLD
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?   @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(USER)
  kycStatus    KycStatus @default(NOT_SUBMITTED)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wallet          Wallet?
  kycProfile      KycProfile?
  transactions    Transaction[]
  paymentRequests PaymentRequest[]
  reviewedKycs    KycProfile[]     @relation("KycReviewer")
  goldRatesSet    GoldRate[]

  @@index([phone])
}

model OtpToken {
  id         String     @id @default(cuid())
  phone      String
  code       String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

model KycProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  nidNumber    String
  documentUrls String[]
  status       KycStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?     @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  cashBalanceBDT  Decimal  @default(0) @db.Decimal(18, 2)
  goldBalanceMg   BigInt   @default(0)
  updatedAt       DateTime @updatedAt

  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String          @id @default(cuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  account       LedgerAccount
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(18, 2)
  balanceAfter  Decimal         @db.Decimal(18, 2)
  referenceType String
  referenceId   String
  createdAt     DateTime        @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  goldMg          BigInt?
  pricePerGramBDT Decimal?          @db.Decimal(18, 2)
  totalAmountBDT  Decimal           @db.Decimal(18, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  paymentRequest PaymentRequest?

  @@index([userId, createdAt])
}

model GoldRate {
  id              String   @id @default(cuid())
  pricePerGramBDT Decimal  @db.Decimal(18, 2)
  setById         String?
  setBy           User?    @relation(fields: [setById], references: [id])
  effectiveAt     DateTime @default(now())

  @@index([effectiveAt])
}

model PaymentRequest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  provider      String        @default("MOCK")
  amountBDT     Decimal       @db.Decimal(18, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
